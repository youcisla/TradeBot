# ── Credentials / Secrets only ───────────────────────────────────────

# Runtime profile
# custom | dev | paper | live-safe | live-full
BOT_PROFILE=custom

# Broker (MT5)
BROKER_ACCOUNT=
BROKER_PASSWORD=
BROKER_SERVER=

# External API keys
ALPHA_VANTAGE_KEY=
TWELVE_DATA_KEY=
FINNHUB_API_KEY=
DEEPSEEK_API_KEY=

# Optional dynamic strategy plugins
# Example:
# STRATEGY_PLUGINS=my_pkg.alpha.AlphaStrategy,my_pkg.beta.BetaStrategy
STRATEGY_PLUGINS=
STRATEGY_PLUGIN_FAIL_FAST=false

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Security
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
