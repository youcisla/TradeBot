# ── Credentials / Secrets only ───────────────────────────────────────

# Runtime profile
# custom | dev | paper | live-safe | live-full
BOT_PROFILE=custom
LOG_LEVEL=DEBUG
DEMO_MODE=false

# Broker (MT5)
BROKER_ACCOUNT=
BROKER_PASSWORD=
BROKER_SERVER=

# External API keys
ALPHA_VANTAGE_KEY=
TWELVE_DATA_KEY=
FINNHUB_API_KEY=
DEEPSEEK_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERNAMES=
TELEGRAM_ALLOWED_USER_IDS=

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Security
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# ── Orchestration speed profile (applied) ─────────────────────────────
RISK_VALIDATION_PROFILE=agile
RISK_AGILE_HIGH_CONF_THRESHOLD=0.74
RISK_AGILE_SPREAD_MULTIPLIER=1.35

# Hard latency budgets (ms) — generous to allow full ICT multi-symbol analysis
ORCHESTRATION_HARD_BUDGET_ENABLED=true
ORCHESTRATION_MAX_SCAN_MS=90000
ORCHESTRATION_MAX_RANK_MS=1000
ORCHESTRATION_MAX_EXEC_MS=3000
ORCHESTRATION_MAX_ITERATION_MS=120000
ORCHESTRATION_EXEC_BUDGET_COUNCIL_MARGIN_MS=350
ORCHESTRATION_TARGET_SCAN_MS=15000
ORCHESTRATION_TARGET_TOTAL_MS=60000

# ML models
LGBM_ENSEMBLE_ENABLED=true
KALMAN_ENABLED=false

# ── Strategy plugins ───────────────────────────────────────────────────────────
STRATEGY_PLUGINS=strategies.ict_strategy.ICTStrategy
STRATEGY_PLUGIN_FAIL_FAST=false

# USE_FULL_UNIVERSE=1
GUARD_PIPELINE_ENABLED=false
DEFERRED_ENTRY_ENABLED=true
FAST_LANE_ENABLED=true
INSTANT_ENTRY_ENABLED=true
SNIPER_ENTRY_ENABLED=true
SNIPER_CONF_THRESHOLD=0.45
FIXED_LOT_SIZE=0.01

# ── Web Dashboard ────────────────────────────────────────────────────
# WebSocket URL for real-time agent event feed (optional — falls back to polling)
NEXT_PUBLIC_WS_URL=

# ── Symbol fault list ──────────────────────────────────────────────────
# Symbols permanently excluded from scanning (known-bad on broker MT5)
PERMANENT_FAULT_SYMBOLS=
HKU_ENABLED=false
HKU_API_URL=
HKU_API_KEY=
HKU_SIGNAL_DISCOUNT=0.80
HKU_PUBLISH_ON_STRATEGY=true
HKU_PUBLISH_ON_DISCUSSION=true
HKU_FEED_LIMIT=10
HKU_CIRCUIT_BREAKER_TIMEOUT_SECS=300
# Copy trading
HKU_COPY_TRADING_ENABLED=false
HKU_COPY_LEADER_IDS=["leader_agent_id_1","leader_agent_id_2"]
HKU_COPY_MARGIN_FRACTION=0.05
HKU_COPY_MAX_TRADES=3
HKU_COPY_MIN_WINRATE=0.55
HKU_COPY_SL_ATR=1.5
HKU_COPY_TP_ATR=2.5

USE_FULL_UNIVERSE=1
ANTHROPIC_API_KEY=