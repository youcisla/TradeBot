# ── Broker (leave empty for MockConnector, fill for real MT5) ─────────
BROKER_ACCOUNT=
BROKER_PASSWORD=
BROKER_SERVER=

# ── Market Data API Keys ──────────────────────────────────────────────
ALPHA_VANTAGE_KEY=
TWELVE_DATA_KEY=

# ── News / Calendar ──────────────────────────────────────────────────
NEWS_CALENDAR_SOURCE=static
FINNHUB_API_KEY=
NEWS_BLACKOUT_MINUTES=15

# ── Telegram Bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Risk Parameters ──────────────────────────────────────────────────
MAX_RISK_PER_TRADE=0.02
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS=0.05
MAX_SPREAD_PIPS=3.0
MAX_SPREAD_PCT_CRYPTO=2.5
MAX_SPREAD_PIPS_COMMODITY=10.0
MAX_SPREAD_PIPS_EXOTIC=15.0
DRAWDOWN_COOLDOWN_HOURS=24
MIN_LOT_SIZE=0.01

# ── Trade Execution ──────────────────────────────────────────────────
TP1_CLOSE_PERCENT=0.40
TP2_CLOSE_PERCENT=0.30
TP3_CLOSE_PERCENT=0.30
TRAILING_STOP_DISTANCE_PIPS=20
COMMISSION_PER_LOT=7.0
BREAKEVEN_SPREAD_OFFSET=true

# ── Bot Loop ─────────────────────────────────────────────────────────
LOOP_INTERVAL_SECONDS=30
RECONCILE_EVERY_N_LOOPS=10

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DAILY_SUMMARY_HOUR=17

# ── Data Validation ──────────────────────────────────────────────────
STUCK_QUOTE_THRESHOLD=10
SPIKE_PERCENT_THRESHOLD=2.0

# ── Symbols ──────────────────────────────────────────────────────────
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=H1

# ── Database (Supabase / Vercel Postgres) ────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# ── Security ─────────────────────────────────────────────────────────
# Symmetric key for encrypting broker passwords in the database.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# ── NextAuth (Vercel web UI) ─────────────────────────────────────────
NEXTAUTH_SECRET=your-random-32-char-secret-here
NEXTAUTH_URL=https://your-app.vercel.app

# ── Crucix World Intelligence (optional — run: cd crucix && node server.mjs) ─
CRUCIX_URL=http://localhost:3117
