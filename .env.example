# ── Credentials / Secrets only ───────────────────────────────────────

# Runtime profile
# custom | dev | paper | live-safe | live-full
BOT_PROFILE=custom

# Broker (MT5)
BROKER_ACCOUNT=
BROKER_PASSWORD=
BROKER_SERVER=

# External API keys
ALPHA_VANTAGE_KEY=
TWELVE_DATA_KEY=
FINNHUB_API_KEY=
DEEPSEEK_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Security
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# ── Orchestration speed profile (applied) ─────────────────────────────
COUNCIL_MODE=advisory
COUNCIL_MAX_REVIEWS_PER_LOOP=2
COUNCIL_ADVISORY_REJECTION_CONF_PENALTY=0.08
RISK_VALIDATION_PROFILE=agile
RISK_AGILE_HIGH_CONF_THRESHOLD=0.74
RISK_AGILE_SPREAD_MULTIPLIER=1.35

# Hard latency budgets (ms) — generous to allow full ICT multi-symbol analysis
ORCHESTRATION_HARD_BUDGET_ENABLED=true
ORCHESTRATION_MAX_SCAN_MS=90000
ORCHESTRATION_MAX_RANK_MS=1000
ORCHESTRATION_MAX_EXEC_MS=3000
ORCHESTRATION_MAX_ITERATION_MS=120000
ORCHESTRATION_EXEC_BUDGET_COUNCIL_MARGIN_MS=350
ORCHESTRATION_TARGET_SCAN_MS=15000
ORCHESTRATION_TARGET_TOTAL_MS=60000

# DeepSeek dual-speed path: quick candidate + deep verifier
DEEPSEEK_QUICK_MODEL=deepseek-chat
DEEPSEEK_DEEP_MODEL=deepseek-reasoner
DEEPSEEK_QUICK_TIMEOUT_SECONDS=10
DEEPSEEK_DEEP_TIMEOUT_SECONDS=8
DEEPSEEK_ENABLE_DEEP_VERIFY=true
DEEPSEEK_DEEP_VERIFY_MIN_CONFIDENCE=0.78

LGBM_ENSEMBLE_ENABLED=true

# ── Strategy plugins ───────────────────────────────────────────────────────────
STRATEGY_PLUGINS=
STRATEGY_PLUGIN_FAIL_FAST=false

# ── Execution ───────────────────────────────────────────────────────────────
# USE_FULL_UNIVERSE=1
GUARD_PIPELINE_ENABLED=false
SNIPER_CONF_THRESHOLD=0.45
FIXED_LOT_SIZE=0.01

# ── Web Dashboard ────────────────────────────────────────────────────
# WebSocket URL for real-time agent event feed (optional — falls back to polling)
NEXT_PUBLIC_WS_URL=
