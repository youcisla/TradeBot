# ── Broker (not used in Phase 1 / MockConnector) ──────────────────────
BROKER_ACCOUNT=
BROKER_PASSWORD=
BROKER_SERVER=

# ── Market Data API Keys ──────────────────────────────────────────────
ALPHA_VANTAGE_KEY=
TWELVE_DATA_KEY=

# ── News / Calendar ──────────────────────────────────────────────────
NEWS_CALENDAR_SOURCE=static
FINNHUB_API_KEY=
NEWS_BLACKOUT_MINUTES=15

# ── Telegram Bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Risk Parameters ──────────────────────────────────────────────────
MAX_RISK_PER_TRADE=0.02
MAX_OPEN_TRADES=3
MAX_DAILY_LOSS=0.05
MAX_SPREAD_PIPS=3.0
DRAWDOWN_COOLDOWN_HOURS=24
MIN_LOT_SIZE=0.01

# ── Trade Execution ──────────────────────────────────────────────────
TP1_CLOSE_PERCENT=0.40
TP2_CLOSE_PERCENT=0.30
TP3_CLOSE_PERCENT=0.30
TRAILING_STOP_DISTANCE_PIPS=20
COMMISSION_PER_LOT=7.0
BREAKEVEN_SPREAD_OFFSET=true

# ── Bot Loop ─────────────────────────────────────────────────────────
LOOP_INTERVAL_SECONDS=60
RECONCILE_EVERY_N_LOOPS=10

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DAILY_SUMMARY_HOUR=17

# ── Data Validation ──────────────────────────────────────────────────
STUCK_QUOTE_THRESHOLD=10
SPIKE_PERCENT_THRESHOLD=2.0

# ── Symbols ──────────────────────────────────────────────────────────
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=H1

# ── Database ─────────────────────────────────────────────────────────
# Vercel Postgres connection string (shared between Python bot and Next.js UI)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_PATH=data/trading_bot.db
